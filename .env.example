# Host ports for docker compose (change if they clash with something on your machine)
POSTGRES_PORT=5434
REDIS_PORT=6381
NGINX_PORT=8088
# Signs sign-in tokens inside the `scale` compose profile (separate from the dev JWT_SECRET below)
# COMPOSE_JWT_SECRET=change-me

# Server (used when running `npm run dev`)
PORT=3001
DATABASE_URL=postgres://board:board@localhost:5434/board
REDIS_URL=redis://localhost:6381
JWT_SECRET=dev-only-change-me
WEB_ORIGIN=http://localhost:5180
