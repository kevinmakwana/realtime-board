# Copy to deploy/.env and fill in. Nothing here has an insecure default: compose refuses to start without the first three.

# The public URL people type into the browser (scheme + host, no trailing slash). Used for CORS and email links.
WEB_ORIGIN=https://board.example.com
# Signs sign-in tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
# Use letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Which images to run. latest follows main; use a release (1.2.3) or sha-<commit> to pin.
# IMAGE_PREFIX=ghcr.io/kevinmakwana/realtime-board
# IMAGE_TAG=latest

# Where nginx listens on the host. Loopback by default (your TLS terminator connects to it); set HTTP_BIND to a
# private address if the terminator is on another machine, and firewall the port.
# HTTP_BIND=127.0.0.1
# HTTP_PORT=80
# Proxies in front of the server: nginx counts as 1. The default, 2, assumes a TLS terminator in front of it; use 1
# only if nginx faces clients directly (then clients cannot reach it over TLS, so only for a trusted network).
# TRUST_PROXY=2

# Email for magic links and invitations. Unset: emails are only printed to the server log.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Realtime Board <no-reply@example.com>

# PG_POOL_MAX=10
# EVENT_RETENTION_DAYS=90

# --- Public demo on one host (see docs/deploy.md, "Public demo") ---
# Lets anyone sign in as any email with one click. Only for a throwaway demo with fictional data: people can read and
# edit each other's boards. Leave off for anything real.
# AUTH_DEV_LOGIN=true
# Automatic HTTPS through the `tls` profile: the domain (or <ip-with-dashes>.sslip.io) that points at this host.
# nginx must then move off port 80, which Caddy needs.
# DOMAIN=board.example.com
# HTTP_PORT=8081
